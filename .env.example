# Required. Generate from Cursor Dashboard -> API Keys (or Integrations, on
# older dashboards). This key can create billable Cloud Agent runs.
CURSOR_API_KEY=

# Required for safe public deployment (e.g. on Zeabur). Any random long
# string works -- generate one with: openssl rand -hex 32
# Configure the SAME value as a Bearer token in your MCP client.
# If left unset, the server logs a warning and accepts unauthenticated requests.
MCP_SERVER_TOKEN=

# "http" (default) for remote/Zeabur deployment, "stdio" for local
# Claude Desktop / Claude Code integration.
TRANSPORT=http

# Port for the HTTP transport. Zeabur sets this automatically; only needed
# for local runs.
PORT=3000
